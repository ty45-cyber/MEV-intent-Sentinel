# Paritok proxy — point the Rust backend at the local proxy, not the upstream API directly
PARITOK_API_KEY=<your_paritok_api_key>
PARITOK_BASE_URL=http://127.0.0.1:8080

# Monad testnet WebSocket RPC
EVM_WS_URL=wss://testnet-rpc.monad.xyz/ws

# Axum server port (proxy occupies 8080, so backend moves to 8081)
PORT=8081

RUST_LOG=info
